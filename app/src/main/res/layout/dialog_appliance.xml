<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/aTitle"
        style="@style/CardTitle" />

    <TextView
        android:id="@+id/aInfo"
        style="@style/Body"
        android:layout_marginTop="4dp" />

    <TextView
        style="@style/Label"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="Consommation par utilisation (kWh)" />

    <EditText
        android:id="@+id/aKwh"
        style="@style/Field"
        android:inputType="numberDecimal"
        android:selectAllOnFocus="true" />

    <TextView
        style="@style/Body"
        android:layout_marginTop="6dp"
        android:text="Astuce : la consommation exacte figure sur l'étiquette énergie ou dans la notice (programme éco)." />

    <Switch
        android:id="@+id/aOn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="J'ai cet appareil"
        android:textColor="@color/fg"
        android:textSize="15sp"
        android:thumbTint="@color/sun"
        android:trackTint="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/aReset"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:stateListAnimator="@null"
            android:text="Valeur moyenne"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="14sp" />

        <Button
            android:id="@+id/aSave"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Enregistrer" />
    </LinearLayout>
</LinearLayout>
