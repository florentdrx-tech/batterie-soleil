<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Soleil &amp; Batterie"
                    android:textColor="@color/fg"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/refresh"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Actualiser"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Carte Aujourd'hui -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/hero_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:text="Aujourd'hui" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/kwh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:includeFontPadding="false"
                            android:text="–"
                            android:textColor="@color/sun"
                            android:textSize="64sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="kWh"
                            android:textColor="@color/muted"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>

                <be.florent.soleil.BatteryView
                    android:id="@+id/battery"
                    android:layout_width="64dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/pill_low"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/sun"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 7 jours -->
        <TextView
            style="@style/Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:text="Les prochains jours" />

        <LinearLayout
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- Calibration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/CardTitle"
                android:text="Ma production réelle" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="4dp"
                android:text="Entre ce que l'onduleur a vraiment produit un jour de la semaine passée : l'appli ajuste toutes ses prévisions (ombrage, saleté, rendement)." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:layout_marginBottom="6dp"
                        android:text="Jour" />

                    <EditText
                        android:id="@+id/calDate"
                        style="@style/Field"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:layout_marginBottom="6dp"
                        android:text="Produit (kWh)" />

                    <EditText
                        android:id="@+id/calKwh"
                        style="@style/Field"
                        android:hint="ex. 3,4"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/calBtn"
                style="@style/PrimaryButton"
                android:layout_marginTop="14dp"
                android:text="Ajuster les prévisions" />

            <TextView
                android:id="@+id/calOut"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Réglages -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/settingsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Mon installation" />

                    <TextView
                        android:id="@+id/settingsSummary"
                        style="@style/Body"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/muted"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:layout_marginBottom="6dp"
                    android:text="Adresse de l'installation" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/address"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="Rue, numéro, commune"
                        android:imeOptions="actionSearch"
                        android:inputType="textPostalAddress" />

                    <Button
                        android:id="@+id/findBtn"
                        style="@style/PrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Chercher" />
                </LinearLayout>

                <TextView
                    android:id="@+id/placeOut"
                    style="@style/Body"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/settingsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="10dp"
                    android:text="Orientation en degrés boussole : 90 = est, 180 = sud, 270 = ouest." />

                <Button
                    android:id="@+id/saveBtn"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="14dp"
                    android:text="Enregistrer" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Données météo : Open-Meteo.com"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
